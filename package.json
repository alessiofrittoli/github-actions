{
	"name": "@alessiofrittoli/github-actions",
	"version": "1.1",
	"description": "Utility library that offers reusable and composable GitHub actions",
	"type": "module",
	"author": {
		"name": "Alessio Frittoli",
		"email": "info@alessiofrittoli.it",
		"url": "https://alessiofrittoli.it"
	},
	"license": "MIT",
	"funding": [
		{
			"type": "github",
			"url": "https://github.com/sponsors/alessiofrittoli"
		}
	],
	"keywords": [
		"github-actions"
	],
	"homepage": "https://github.com/alessiofrittoli/github-actions#readme",
	"bugs": {
		"url": "https://github.com/alessiofrittoli/github-actions/issues",
		"email": "info@alessiofrittoli.it"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alessiofrittoli/github-actions.git"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=24.15.0",
		"pnpm": ">=11.27.1"
	},
	"scripts": {
		"//1a": "*********************************************************************",
		"//1b": "*************************** LINT - RELEASE **************************",
		"//1c": "*********************************************************************",
		"lint": "oxlint --report-unused-disable-directives --max-warnings 0",
		"build": "pnpm lint && pnpm tsc",
		"release": "node scripts/release.ts --verbose",
		"//2a": "*********************************************************************",
		"//2b": "***************************** UNIT TESTS ****************************",
		"//2c": "*********************************************************************",
		"test": "vitest --reporter=tree",
		"test:watch": "pnpm test watch",
		"test:ci": "pnpm test run",
		"//3a": "*********************************************************************",
		"//3b": "************************ UNIT TESTS COVERAGE ************************",
		"//3c": "*********************************************************************",
		"test:coverage": "pnpm test:watch --coverage",
		"test:coverage:ci": "pnpm test:ci --coverage",
		"test:serve-coverage": "http-server ./coverage --gzip true -p 0 -o /index.html --silent",
		"test:coverage:serve": "concurrently --prefix none --kill-others \"pnpm test:coverage\" \"pnpm test:serve-coverage\""
	},
	"devDependencies": {
		"@alessiofrittoli/node-scripts": "^4.2.0",
		"@alessiofrittoli/package-configs": "^1.9.0",
		"@types/node": "^24.13.6",
		"@vitest/coverage-v8": "^5.0.5",
		"concurrently": "^10.0.6",
		"http-server": "^14.1.1",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"prettier": "^3.9.10",
		"prettier-plugin-sort-imports": "^1.8.11",
		"typescript": "^6.0.3",
		"vitest": "^5.0.5"
	}
}
